# Backend API URL
VITE_API_URL=http://localhost:5000/api/v1

# Clerk Authentication — get your key from https://dashboard.clerk.com -> API Keys
# Development keys start with pk_test_; production keys start with pk_live_
# REPLACE the value below with your own key — never commit real keys to git
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY_HERE
