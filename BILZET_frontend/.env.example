# =============================================================================
# BILZET Frontend Environment Configuration (.env)
# =============================================================================

# Backend API URL (optional in production on Vercel as /api/v1 is rewritten locally)
VITE_API_URL=http://localhost:5000/api/v1

# Clerk Publishable Key (Required for Clerk Authentication)
# - In Development (localhost): pk_test_...
# - In Production (bilzet.in / Vercel): pk_live_...
# Obtain from Clerk Dashboard: https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_ACTUAL_KEY
