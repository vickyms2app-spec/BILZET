datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  VIEWER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CASHIER)
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sales        Sale[]
  expenses     Expense[]
  auditLogs    AuditLog[]
  subscriptions Subscription[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  sku           String    @unique
  barcode       String?   @unique
  categoryId    String?   @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  brand         String?
  unit          String    @default("piece")
  purchasePrice Decimal   @default(0) @db.Decimal(12, 2) @map("purchase_price")
  sellingPrice  Decimal   @db.Decimal(12, 2) @map("selling_price")
  gstRate       Decimal   @default(0) @db.Decimal(5, 2) @map("gst_rate")
  stock         Int       @default(0)
  minimumStock  Int       @default(5) @map("minimum_stock")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  saleItems         SaleItem[]
  stockTransactions StockTransaction[]

  @@map("products")
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  phone       String?   @unique
  email       String?
  address     String?
  gstin       String?
  state       String?
  creditLimit Decimal   @default(0) @db.Decimal(12, 2) @map("credit_limit")
  balance     Decimal   @default(0) @db.Decimal(12, 2)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sales       Sale[]
  payments    Payment[]

  @@map("customers")
}

model Sale {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2) @map("discount_total")
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2) @map("tax_total")
  roundOff      Decimal       @default(0) @db.Decimal(6, 2) @map("round_off")
  grandTotal    Decimal       @db.Decimal(12, 2) @map("grand_total")
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2) @map("paid_amount")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  status        SaleStatus    @default(COMPLETED)
  createdById   String?       @map("created_by_id")
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items         SaleItem[]
  payments      Payment[]

  @@map("sales")
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String   @map("sale_id")
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String?  @map("product_id")
  product    Product? @relation(fields: [productId], references: [id])
  name       String
  sku        String?
  quantity   Int
  rate       Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  gstRate    Decimal  @default(0) @db.Decimal(5, 2) @map("gst_rate")
  taxAmount  Decimal  @default(0) @db.Decimal(12, 2) @map("tax_amount")
  total      Decimal  @db.Decimal(12, 2)

  @@map("sale_items")
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String?       @map("sale_id")
  sale          Sale?         @relation(fields: [saleId], references: [id])
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  transactionId String?       @map("transaction_id")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model Expense {
  id            String        @id @default(uuid())
  title         String
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  date          DateTime      @default(now())
  note          String?
  recordedById  String?       @map("recorded_by_id")
  recordedBy    User?         @relation(fields: [recordedById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("expenses")
}

model StockTransaction {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  type          String   // IN, OUT, ADJUST
  quantity      Int
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("stock_transactions")
}

model ShopSettings {
  id            String   @id @default(uuid())
  shopName      String   @default("BILZET Retail Mart") @map("shop_name")
  ownerName     String?  @map("owner_name")
  phone         String?
  email         String?
  address       String?
  gstin         String?
  state         String?
  stateCode     String?  @map("state_code")
  invoicePrefix String   @default("INV-") @map("invoice_prefix")
  paperSize     String   @default("A4") @map("paper_size")
  terms         String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  changes   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Subscription {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName     String    @default("Free Starter") @map("plan_name")
  planTier     String    @default("FREE") @map("plan_tier")
  status       String    @default("ACTIVE")
  billingCycle String    @default("MONTHLY") @map("billing_cycle")
  amount       Decimal   @default(0.00) @db.Decimal(10, 2)
  startDate    DateTime  @default(now()) @map("start_date")
  expiresAt    DateTime? @map("expires_at")
  features     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model AppConfig {
  id               String   @id @default("global-config")
  maintenanceMode  Boolean  @default(false) @map("maintenance_mode")
  announcementText String?  @map("announcement_text")
  announcementType String   @default("info") @map("announcement_type")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("app_configs")
}
