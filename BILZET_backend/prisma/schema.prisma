datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  CASHIER
  VIEWER
  SALES_STAFF
  PURCHASE_STAFF
  INVENTORY_STAFF
  HR_MANAGER
  CA
  ACCOUNTANT
  NONE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  PARTIAL
  PENDING
  UNPAID
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Business {
  id              String         @id @default(uuid())
  ownerId         String         @map("owner_id")
  name            String         @default("My Business")
  businessType    String?        @default("RETAIL") @map("business_type")
  gstin           String?
  phone           String?
  email           String?
  address         String?
  state           String?        @default("Tamil Nadu")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  owner           User           @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         User[]         @relation("BusinessMembers")
  roles           AppRole[]
  staffMembers    Staff[]
  attendances     StaffAttendance[]
  customers       Customer[]
  sales           Sale[]
  caAccesses      CaStoreAccess[] @relation("BusinessCAAccess")
  caInvitations   CaInvitation[]  @relation("BusinessCAInvitations")
  businessMembers BusinessMember[]
  roleInvitations RoleInvitation[]
  expenses        Expense[]
  caExceptions    CaException[]

  @@index([ownerId])
  @@map("businesses")
}

model User {
  id           String   @id @default(uuid())
  businessId   String?  @map("business_id")
  business     Business? @relation("BusinessMembers", fields: [businessId], references: [id])
  ownedBusinesses Business[] @relation("BusinessOwner")

  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  avatar       String?
  role         Role     @default(CASHIER)
  appRoleId    String?  @map("app_role_id")
  appRole      AppRole? @relation(fields: [appRoleId], references: [id])
  isOwner      Boolean  @default(false) @map("is_owner")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  staffRecord         Staff?
  attendances         StaffAttendance[]
  permissionOverrides UserPermission[]
  sales               Sale[]
  expenses            Expense[]
  auditLogs           AuditLog[]
  subscriptions       Subscription[]
  caAccesses          CaStoreAccess[] @relation("CAUserAccess")
  sentCaInvites            CaInvitation[]   @relation("InvitedCAUsers")
  acceptedCaInvites        CaInvitation[]   @relation("AcceptedCAInvitations")
  businessMemberships      BusinessMember[]
  sentRoleInvitations      RoleInvitation[] @relation("InvitedRoleUsers")
  receivedRoleInvitations  RoleInvitation[] @relation("ReceivedRoleInvitations")
  notifications            Notification[]
  caReferralProfile        CaReferralProfile?

  @@index([businessId])
  @@map("users")
}

model AppRole {
  id          String           @id @default(uuid())
  businessId  String?          @map("business_id")
  business    Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  code        String           // e.g. 'ADMIN', 'MANAGER', 'CASHIER', 'SENIOR_CASHIER'
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "billing.create", "inventory.adjust"
  module      String           // e.g. "billing", "inventory", "reports"
  action      String           // e.g. "create", "adjust", "view"
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userOverrides   UserPermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean    // true = force grant, false = force revoke

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model Category {
  id             String    @id @default(uuid())
  name           String    @unique
  description    String?
  defaultGstRate Decimal   @default(18) @db.Decimal(5, 2) @map("default_gst_rate")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  products       Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  sku           String    @unique
  barcode       String?   @unique
  categoryId    String?   @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  brand         String?
  unit          String    @default("piece")
  purchasePrice Decimal   @default(0) @db.Decimal(12, 2) @map("purchase_price")
  sellingPrice  Decimal   @db.Decimal(12, 2) @map("selling_price")
  gstRate       Decimal   @default(0) @db.Decimal(5, 2) @map("gst_rate")
  hsnCode       String?   @map("hsn_code")
  stock         Int       @default(0)
  minimumStock  Int       @default(5) @map("minimum_stock")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  stockTransactions StockTransaction[]
  warehouseStocks   WarehouseStock[]

  @@map("products")
}

model Warehouse {
  id            String    @id @default(uuid())
  name          String
  code          String    @unique
  address       String?
  contactPerson String?   @map("contact_person")
  phone         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  stocks        WarehouseStock[]

  @@map("warehouses")
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([warehouseId, productId])
  @@map("warehouse_stocks")
}

model StockTransfer {
  id             String   @id @default(uuid())
  transferNumber String   @unique @map("transfer_number")
  fromWarehouseId String  @map("from_warehouse_id")
  toWarehouseId   String  @map("to_warehouse_id")
  productId      String   @map("product_id")
  quantity       Int
  status         String   @default("COMPLETED")
  notes          String?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("stock_transfers")
}

model Customer {
  id          String    @id @default(uuid())
  businessId  String?   @map("business_id")
  business    Business? @relation(fields: [businessId], references: [id])
  name        String
  phone       String?   @unique
  email       String?
  address     String?
  gstin          String?
  state          String?
  customerType   String?   @default("B2C") @map("customer_type") // B2B, B2C, SEZ, UNCLASSIFIED
  isSez          Boolean   @default(false) @map("is_sez")
  sezUnitType    String?   @map("sez_unit_type") // UNIT, DEVELOPER
  creditLimit    Decimal   @default(0) @db.Decimal(12, 2) @map("credit_limit")
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sales       Sale[]
  payments    Payment[]

  @@index([businessId])
  @@map("customers")
}

model Sale {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  businessId    String?       @map("business_id")
  business      Business?     @relation(fields: [businessId], references: [id])
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  warehouseId   String?       @map("warehouse_id")
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2) @map("discount_total")
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2) @map("tax_total")
  roundOff      Decimal       @default(0) @db.Decimal(6, 2) @map("round_off")
  grandTotal    Decimal       @db.Decimal(12, 2) @map("grand_total")
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2) @map("paid_amount")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  status        SaleStatus    @default(COMPLETED)
  returnStatus    String        @default("NONE") @map("return_status") // NONE, PARTIALLY_RETURNED, RETURNED
  customerType    String?       @map("customer_type") // B2B, B2C, SEZ, UNCLASSIFIED
  isSez           Boolean       @default(false) @map("is_sez")
  sezTaxTreatment String?       @map("sez_tax_treatment") // WITH_PAYMENT, WITHOUT_PAYMENT_UNDER_LUT
  dueDate         DateTime?     @map("due_date")
  createdById   String?       @map("created_by_id")
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items         SaleItem[]
  payments      Payment[]
  returns       SalesReturn[]

  @@index([businessId])
  @@index([createdById])
  @@map("sales")
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String   @map("sale_id")
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String?  @map("product_id")
  product    Product? @relation(fields: [productId], references: [id])
  name       String
  sku        String?
  hsnCode    String?  @map("hsn_code")
  quantity   Int
  rate       Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  gstRate    Decimal  @default(0) @db.Decimal(5, 2) @map("gst_rate")
  taxAmount  Decimal  @default(0) @db.Decimal(12, 2) @map("tax_amount")
  total      Decimal  @db.Decimal(12, 2)

  @@map("sale_items")
}

model SalesReturn {
  id           String    @id @default(uuid())
  returnNumber String    @unique @map("return_number")
  saleId       String    @map("sale_id")
  sale         Sale      @relation(fields: [saleId], references: [id])
  customerId   String?   @map("customer_id")
  totalAmount  Decimal   @db.Decimal(12, 2) @map("total_amount")
  reason       String?
  refundStatus String    @default("COMPLETED") @map("refund_status")
  createdAt    DateTime  @default(now()) @map("created_at")

  items        SalesReturnItem[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id            String      @id @default(uuid())
  salesReturnId String      @map("sales_return_id")
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  productId     String      @map("product_id")
  quantity      Int
  rate          Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)

  @@map("sales_return_items")
}

model DeliveryChallan {
  id               String   @id @default(uuid())
  challanNumber    String   @unique @map("challan_number")
  customerId       String?  @map("customer_id")
  warehouseId      String?  @map("warehouse_id")
  deliveryAddress  String?  @map("delivery_address")
  transportDetails String?  @map("transport_details")
  status           String   @default("DELIVERED")
  deliveryDate     DateTime @default(now()) @map("delivery_date")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("delivery_challans")
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String?       @map("sale_id")
  sale          Sale?         @relation(fields: [saleId], references: [id])
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  transactionId String?       @map("transaction_id")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  companyName String?  @map("company_name")
  phone       String?
  email       String?
  address     String?
  gstin       String?
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchases       Purchase[]
  purchaseOrders  PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id               String   @id @default(uuid())
  poNumber         String   @unique @map("po_number")
  supplierId       String   @map("supplier_id")
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  warehouseId      String?  @map("warehouse_id")
  status           String   @default("PENDING") // DRAFT, PENDING, APPROVED, ORDERED, RECEIVED, CANCELLED
  expectedDelivery DateTime? @map("expected_delivery")
  subtotal         Decimal  @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal  @default(0) @db.Decimal(12, 2) @map("tax_total")
  grandTotal       Decimal  @default(0) @db.Decimal(12, 2) @map("grand_total")
  items            Json?    @default("[]")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model Purchase {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  poNumber      String?       @map("po_number")
  supplierId    String        @map("supplier_id")
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  warehouseId   String?       @map("warehouse_id")
  subtotal      Decimal       @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2) @map("tax_total")
  discountTotal Decimal       @default(0) @db.Decimal(12, 2) @map("discount_total")
  grandTotal    Decimal       @db.Decimal(12, 2) @map("grand_total")
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2) @map("paid_amount")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  status        String        @default("COMPLETED")
  dueDate       DateTime?     @map("due_date")
  purchaseDate  DateTime      @default(now()) @map("purchase_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items         PurchaseItem[]
  returns       PurchaseReturn[]

  @@map("purchases")
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String   @map("purchase_id")
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int
  purchasePrice Decimal  @db.Decimal(12, 2) @map("purchase_price")
  gstRate       Decimal  @default(0) @db.Decimal(5, 2) @map("gst_rate")
  taxAmount     Decimal  @default(0) @db.Decimal(12, 2) @map("tax_amount")
  total         Decimal  @db.Decimal(12, 2)

  @@map("purchase_items")
}

model PurchaseReturn {
  id           String   @id @default(uuid())
  returnNumber String   @unique @map("return_number")
  purchaseId   String   @map("purchase_id")
  purchase     Purchase @relation(fields: [purchaseId], references: [id])
  supplierId   String   @map("supplier_id")
  totalAmount  Decimal  @db.Decimal(12, 2) @map("total_amount")
  reason       String?
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("purchase_returns")
}

model DebitNote {
  id               String   @id @default(uuid())
  debitNoteNumber  String   @unique @map("debit_note_number")
  supplierId       String   @map("supplier_id")
  referenceInvoice String?  @map("reference_invoice")
  amount           Decimal  @db.Decimal(12, 2)
  reason           String?
  status           String   @default("ISSUED")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("debit_notes")
}

model Expense {
  id            String        @id @default(uuid())
  businessId    String?       @map("business_id")
  business      Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title         String
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  date          DateTime      @default(now())
  note          String?
  recordedById  String?       @map("recorded_by_id")
  recordedBy    User?         @relation(fields: [recordedById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([businessId])
  @@map("expenses")
}

model Staff {
  id               String    @id @default(uuid())
  staffId          String    @unique @map("staff_id")
  name             String
  email            String?
  phone            String?
  address          String?
  role             String    @default("Staff")
  department       String    @default("Sales")
  salary           Decimal   @default(0) @db.Decimal(12, 2)
  joiningDate      DateTime  @default(now()) @map("joining_date")
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE, TERMINATED
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  businessId       String?   @map("business_id")
  business         Business? @relation(fields: [businessId], references: [id])
  userId           String?   @unique @map("user_id")
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  attendances      StaffAttendance[]
  payrolls         StaffPayroll[]

  @@index([businessId])
  @@index([isDeleted])
  @@map("staff")
}

model StaffAttendance {
  id           String    @id @default(uuid())
  staffId      String?   @map("staff_id")
  staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  userId       String?   @map("user_id")
  user         User?     @relation(fields: [userId], references: [id])
  businessId   String?   @map("business_id")
  business     Business? @relation(fields: [businessId], references: [id])
  date         DateTime  @default(now())
  checkIn      DateTime? @map("check_in")
  checkOut     DateTime? @map("check_out")
  workingHours Decimal?  @map("working_hours") @db.Decimal(4, 1)
  status       String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE, LATE, OVERTIME
  hours        Decimal   @default(8.0) @db.Decimal(4, 1)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([businessId, date])
  @@index([userId, date])
  @@map("staff_attendances")
}

model StaffPayroll {
  id            String    @id @default(uuid())
  staffId       String    @map("staff_id")
  staff         Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  basicSalary   Decimal   @db.Decimal(12, 2) @map("basic_salary")
  allowances    Decimal   @default(0) @db.Decimal(12, 2)
  deductions    Decimal   @default(0) @db.Decimal(12, 2)
  overtimePay   Decimal   @default(0) @db.Decimal(12, 2) @map("overtime_pay")
  bonus         Decimal   @default(0) @db.Decimal(12, 2)
  netSalary     Decimal   @db.Decimal(12, 2) @map("net_salary")
  paymentStatus String    @default("PAID") @map("payment_status")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("staff_payrolls")
}

model OnlineOrder {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  customerName    String      @map("customer_name")
  customerPhone   String?     @map("customer_phone")
  customerEmail   String?     @map("customer_email")
  deliveryAddress String?     @map("delivery_address")
  totalAmount     Decimal     @db.Decimal(12, 2) @map("total_amount")
  paymentStatus   String      @default("PAID") @map("payment_status")
  orderStatus     OrderStatus @default(PENDING) @map("order_status")
  items           Json?
  orderDate       DateTime    @default(now()) @map("order_date")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("online_orders")
}

model SmsCampaign {
  id             String   @id @default(uuid())
  title          String
  targetGroup    String   @default("ALL") @map("target_group") // ALL, REGULAR, NEW, INACTIVE
  message        String   @db.Text
  recipientCount Int      @default(0) @map("recipient_count")
  sentCount      Int      @default(0) @map("sent_count")
  deliveredCount Int      @default(0) @map("delivered_count")
  failedCount    Int      @default(0) @map("failed_count")
  status         String   @default("SENT") // DRAFT, SCHEDULED, SENT, FAILED
  scheduledAt    DateTime? @map("scheduled_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("sms_campaigns")
}

model StockTransaction {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  type          String   // IN, OUT, ADJUST, TRANSFER
  quantity      Int
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("stock_transactions")
}

model ShopSettings {
  id            String   @id @default(uuid())
  shopName      String   @default("BILZET Retail Mart") @map("shop_name")
  ownerName     String?  @map("owner_name")
  phone         String?
  email         String?
  address       String?
  gstin         String?
  state         String?
  stateCode     String?  @map("state_code")
  invoicePrefix String   @default("INV-") @map("invoice_prefix")
  paperSize     String   @default("A4") @map("paper_size")
  terms         String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  changes   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName         String    @default("Free Starter") @map("plan_name")
  planTier         String    @default("FREE") @map("plan_tier")
  status           String    @default("ACTIVE")
  billingCycle     String    @default("MONTHLY") @map("billing_cycle")
  amount           Decimal   @default(0.00) @db.Decimal(10, 2)
  maxSubUsers      Int       @default(0) @map("max_sub_users")
  startDate        DateTime  @default(now()) @map("start_date")
  endDate          DateTime? @map("end_date")
  expiresAt        DateTime? @map("expires_at")
  paymentReference String?   @map("payment_reference")
  paymentMethod    String?   @default("UPI") @map("payment_method")
  paymentStatus    String?   @default("PAID") @map("payment_status")
  features         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model AppConfig {
  id               String   @id @default("global-config")
  maintenanceMode  Boolean  @default(false) @map("maintenance_mode")
  announcementText String?  @map("announcement_text")
  announcementType String   @default("info") @map("announcement_type")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("app_configs")
}


model AuditTask {
  id              String    @id @default(uuid())
  businessId      String    @map("business_id")
  title           String
  description     String?
  category        String    @default("GENERAL") // SALES, PURCHASES, GST, INVENTORY, BANK, EXPENSES
  status          String    @default("PENDING") // PENDING, IN_REVIEW, FLAGGED, CORRECTION_REQUESTED, RESOLVED, COMPLETED
  priority        String    @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  assignedToId    String?   @map("assigned_to_id")
  createdById     String?   @map("created_by_id")
  dueDate         DateTime? @map("due_date")
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  resolutionNotes String?   @map("resolution_notes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([status])
  @@map("audit_tasks")
}

model AuditDiscrepancy {
  id                  String    @id @default(uuid())
  businessId          String    @map("business_id")
  taskId              String?   @map("task_id")
  title               String
  description         String
  entityType          String    @map("entity_type") // INVOICE, PURCHASE, EXPENSE, TAX, INVENTORY, PAYMENT
  entityId            String?   @map("entity_id")
  referenceNumber     String?   @map("reference_number")
  discrepancyType     String    @default("TAX_MISMATCH") @map("discrepancy_type") // TAX_MISMATCH, MISSING_EVIDENCE, UNBALANCED_PAYMENT, UNMATCHED_RETURN, CALCULATION_ERROR
  amount              Decimal?  @db.Decimal(12, 2)
  status              String    @default("FLAGGED") // FLAGGED, CORRECTION_REQUESTED, RESOLVED, VERIFIED, DISMISSED
  flaggedById         String?   @map("flagged_by_id")
  correctionRequested String?   @map("correction_requested")
  correctionResponse  String?   @map("correction_response")
  verifiedAt          DateTime? @map("verified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([status])
  @@map("audit_discrepancies")
}

model AuditDocument {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  title        String
  fileUrl      String   @map("file_url")
  fileType     String?  @map("file_type") // PDF, EXCEL, IMAGE, CSV
  fileSize     Int?     @map("file_size")
  category     String   @default("SUPPORTING_EVIDENCE") // INVOICE, PURCHASE_BILL, BANK_STATEMENT, CREDIT_NOTE, TAX_CHALLAN
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@map("audit_documents")
}

model PeriodClosing {
  id                     String    @id @default(uuid())
  businessId             String    @map("business_id")
  period                 String    // e.g., '2026-09', '2026-Q2', '2026-2027'
  periodType             String    @default("MONTHLY") @map("period_type") // MONTHLY, QUARTERLY, ANNUAL
  status                 String    @default("OPEN") // OPEN, IN_REVIEW, RECONCILED, CLOSED, SIGNED_OFF
  totalSales             Decimal   @default(0) @db.Decimal(14, 2) @map("total_sales")
  totalPurchases         Decimal   @default(0) @db.Decimal(14, 2) @map("total_purchases")
  totalGstCollected      Decimal   @default(0) @db.Decimal(14, 2) @map("total_gst_collected")
  totalGstAdjusted       Decimal   @default(0) @db.Decimal(14, 2) @map("total_gst_adjusted")
  netGstPayable          Decimal   @default(0) @db.Decimal(14, 2) @map("net_gst_payable")
  discrepanciesCount     Int       @default(0) @map("discrepancies_count")
  resolvedDiscrepancies  Int       @default(0) @map("resolved_discrepancies")
  signedOffById          String?   @map("signed_off_by_id")
  signedOffAt            DateTime? @map("signed_off_at")
  signOffNotes           String?   @map("sign_off_notes")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([businessId, period])
  @@index([businessId])
  @@map("period_closings")
}

model CaStoreAccess {
  id           String    @id @default(uuid())
  caUserId     String    @map("ca_user_id")
  caUser       User      @relation("CAUserAccess", fields: [caUserId], references: [id], onDelete: Cascade)
  businessId   String    @map("business_id")
  business     Business  @relation("BusinessCAAccess", fields: [businessId], references: [id], onDelete: Cascade)
  status       String    @default("ACTIVE") // ACTIVE, REVOKED, SUSPENDED
  permissions  Json      @default("[\"sales_audit\", \"purchase_audit\", \"tax_audit\", \"reconciliation\", \"reports\", \"tasks\", \"discrepancies\", \"documents\"]")
  role         String    @default("CA")     // CA, AUDITOR, TAX_CONSULTANT
  assignedById String?   @map("assigned_by_id")
  revokedAt    DateTime? @map("revoked_at")
  revokedById  String?   @map("revoked_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([caUserId, businessId])
  @@index([caUserId])
  @@index([businessId])
  @@map("ca_store_access")
}

model CaInvitation {
  id               String    @id @default(uuid())
  businessId       String    @map("business_id")
  business         Business  @relation("BusinessCAInvitations", fields: [businessId], references: [id], onDelete: Cascade)
  inviterId        String    @map("inviter_id")
  inviter          User      @relation("InvitedCAUsers", fields: [inviterId], references: [id], onDelete: Cascade)
  caUserId         String?   @map("ca_user_id")
  caUser           User?     @relation("AcceptedCAInvitations", fields: [caUserId], references: [id], onDelete: SetNull)
  email            String
  name             String?
  tokenHash        String    @unique @map("token_hash")
  status           String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED, DECLINED, FAILED
  deliveryStatus   String    @default("SENT") @map("delivery_status") // PENDING, SENT, DELIVERED, FAILED
  deliveryError    String?   @map("delivery_error")
  deliveryAttempts Int       @default(1) @map("delivery_attempts")
  message          String?
  permissions      Json      @default("[\"sales_audit\", \"purchase_audit\", \"tax_audit\", \"reconciliation\", \"reports\", \"tasks\", \"discrepancies\", \"documents\"]")
  role             String    @default("CA")
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  declinedAt       DateTime? @map("declined_at")
  revokedAt        DateTime? @map("revoked_at")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([email])
  @@index([status])
  @@map("ca_invitations")
}

model BusinessMember {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String    @map("business_id")
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role         Role      @default(STAFF)
  department   String?
  designation  String?
  permissions  Json?
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  invitedBy    String?   @map("invited_by")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("business_members")
}

model RoleInvitation {
  id               String         @id @default(uuid())
  businessId       String         @map("business_id")
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inviterId        String         @map("inviter_id")
  inviter          User           @relation("InvitedRoleUsers", fields: [inviterId], references: [id], onDelete: Cascade)
  recipientEmail   String         @map("recipient_email")
  recipientUserId  String?        @map("recipient_user_id")
  recipientUser    User?          @relation("ReceivedRoleInvitations", fields: [recipientUserId], references: [id], onDelete: SetNull)
  name             String?
  role             Role           @default(STAFF)
  department       String?
  designation      String?
  permissions      Json?
  tokenHash        String         @unique @map("token_hash")
  status           String         @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED, REVOKED
  deliveryStatus   String         @default("PENDING") @map("delivery_status") // PENDING, SENT, DELIVERED, FAILED
  deliveryError    String?        @map("delivery_error")
  message          String?
  expiresAt        DateTime       @map("expires_at")
  acceptedAt       DateTime?      @map("accepted_at")
  rejectedAt       DateTime?      @map("rejected_at")
  revokedAt        DateTime?      @map("revoked_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  notifications    Notification[]

  @@index([businessId])
  @@index([recipientEmail])
  @@index([status])
  @@map("role_invitations")
}

model Notification {
  id           String          @id @default(uuid())
  userId       String?         @map("user_id")
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String?
  type         String          @default("INVITATION") // INVITATION, ROLE_ASSIGNED, INVITATION_ACCEPTED, INVITATION_REJECTED, SYSTEM
  title        String
  message      String
  invitationId String?         @map("invitation_id")
  invitation   RoleInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  data         Json?
  isRead       Boolean         @default(false) @map("is_read")
  readAt       DateTime?       @map("read_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([email])
  @@index([isRead])
  @@map("notifications")
}

model CaReferralProfile {
  id                String                   @id @default(uuid())
  userId            String                   @unique @map("user_id")
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode      String                   @unique @map("referral_code")
  totalCoinsEarned  Int                      @default(0) @map("total_coins_earned")
  availableCoins    Int                      @default(0) @map("available_coins")
  reservedCoins     Int                      @default(0) @map("reserved_coins")
  redeemedCoins     Int                      @default(0) @map("redeemed_coins")
  totalPayoutRupees Int                      @default(0) @map("total_payout_rupees")
  isEligible        Boolean                  @default(true) @map("is_eligible")
  isVerified        Boolean                  @default(true) @map("is_verified")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  attributions      CaReferralAttribution[]
  ledgerEntries     CaRewardLedger[]
  redemptions       CaRedemptionRequest[]

  @@map("ca_referral_profiles")
}

model CaReferralAttribution {
  id                   String            @id @default(uuid())
  caUserId             String            @map("ca_user_id")
  caProfile            CaReferralProfile @relation(fields: [caUserId], references: [userId], onDelete: Cascade)
  referredBusinessId   String            @unique @map("referred_business_id")
  referredOwnerId      String?           @map("referred_owner_id")
  referredBusinessName String?           @map("referred_business_name")
  referralCode         String            @map("referral_code")
  status               String            @default("REGISTERED") // REGISTERED, ELIGIBLE, INELIGIBLE, REVERSED
  qualifyingPaymentRef String?           @map("qualifying_payment_ref")
  qualifyingPaymentDate DateTime?        @map("qualifying_payment_date")
  qualifyingPlanTier   String?           @map("qualifying_plan_tier")
  rewardCoins          Int               @default(100) @map("reward_coins")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  ledgerEntries        CaRewardLedger[]

  @@index([caUserId])
  @@index([referralCode])
  @@index([status])
  @@map("ca_referral_attributions")
}

model CaRewardLedger {
  id              String                 @id @default(uuid())
  caUserId        String                 @map("ca_user_id")
  caProfile       CaReferralProfile      @relation(fields: [caUserId], references: [userId], onDelete: Cascade)
  attributionId   String?                @map("attribution_id")
  attribution     CaReferralAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  redemptionId    String?                @map("redemption_id")
  redemption      CaRedemptionRequest?   @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  entryType       String                 @map("entry_type") // REWARD_CREDIT, REDEMPTION_RESERVE, REDEMPTION_PAYOUT_FINAL, REDEMPTION_RELEASE, ADMIN_ADJUSTMENT_CREDIT, ADMIN_ADJUSTMENT_DEBIT
  coins           Int
  balanceAfter    Int                    @map("balance_after")
  idempotencyKey  String                 @unique @map("idempotency_key")
  description     String
  actorId         String?                @map("actor_id")
  metadata        Json?
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([caUserId])
  @@index([entryType])
  @@map("ca_reward_ledgers")
}

model CaRedemptionRequest {
  id               String            @id @default(uuid())
  caUserId         String            @map("ca_user_id")
  caProfile        CaReferralProfile @relation(fields: [caUserId], references: [userId], onDelete: Cascade)
  coinsRequested   Int               @map("coins_requested")
  rupeeAmount      Int               @map("rupee_amount")
  payoutMethod     String            @default("UPI") @map("payout_method") // UPI, BANK_TRANSFER
  payoutDetails    Json              @map("payout_details")
  status           String            @default("PENDING_REVIEW") @map("status") // PENDING_REVIEW, APPROVED, REJECTED, PAYMENT_PROCESSING, PAID, CANCELLED
  rejectionReason  String?           @map("rejection_reason")
  paymentReference String?           @map("payment_reference")
  paymentDate      DateTime?         @map("payment_date")
  reviewedById     String?           @map("reviewed_by_id")
  reviewedAt       DateTime?         @map("reviewed_at")
  paidById         String?           @map("paid_by_id")
  paidAt           DateTime?         @map("paid_at")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  ledgerEntries    CaRewardLedger[]

  @@index([caUserId])
  @@index([status])
  @@map("ca_redemption_requests")
}

model CaReferralConfig {
  id                 String   @id @default("global_ca_referral_config")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  coinsPerReferral   Int      @default(100) @map("coins_per_referral")
  rupeesPerCoin      Float    @default(1.0) @map("rupees_per_coin")
  minRedemptionCoins Int      @default(500) @map("min_redemption_coins")
  updatedById        String?  @map("updated_by_id")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("ca_referral_configs")
}

model CaException {
  id               String    @id @default(uuid())
  businessId       String    @map("business_id")
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category         String    @default("GST_MISMATCH") // GST_MISMATCH, RETURNS_CREDIT_NOTE, MISSING_INVOICE, PENDING_DOCUMENT, UNCLASSIFIED_TAX
  exceptionType    String    @map("exception_type") // RATE_MISMATCH, ARITHMETIC_VARIANCE, EXCESS_RETURN, UNMATCHED_CREDIT_NOTE, MISSING_INVOICE, PENDING_DOCUMENT, UNCLASSIFIED_CUSTOMER, MISSING_GSTIN
  title            String
  description      String
  referenceNumber  String?   @map("reference_number")
  invoiceId        String?   @map("invoice_id")
  invoiceDate      DateTime? @map("invoice_date")
  customerType     String    @default("UNCLASSIFIED") @map("customer_type") // B2B, B2C, SEZ, UNCLASSIFIED
  customerName     String?   @map("customer_name")
  customerGstin    String?   @map("customer_gstin")
  placeOfSupply    String?   @map("place_of_supply")
  amount           Decimal   @default(0) @db.Decimal(12, 2)
  gstAmount        Decimal   @default(0) @db.Decimal(12, 2) @map("gst_amount")
  taxableAmount    Decimal   @default(0) @db.Decimal(12, 2) @map("taxable_amount")
  expectedGst      Decimal   @default(0) @db.Decimal(12, 2) @map("expected_gst")
  differenceAmount Decimal   @default(0) @db.Decimal(12, 2) @map("difference_amount")
  cgst             Decimal   @default(0) @db.Decimal(12, 2)
  sgst             Decimal   @default(0) @db.Decimal(12, 2)
  igst             Decimal   @default(0) @db.Decimal(12, 2)
  portalCgst       Decimal?  @db.Decimal(12, 2) @map("portal_cgst")
  portalSgst       Decimal?  @db.Decimal(12, 2) @map("portal_sgst")
  portalIgst       Decimal?  @db.Decimal(12, 2) @map("portal_igst")
  portalTaxable    Decimal?  @db.Decimal(12, 2) @map("portal_taxable")
  sezTaxTreatment  String?   @map("sez_tax_treatment") // WITH_PAYMENT, WITHOUT_PAYMENT_UNDER_LUT
  status           String    @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, REOPENED
  severity         String    @default("HIGH") // LOW, MEDIUM, HIGH, URGENT
  sourceType       String    @default("SALES_INVOICE") @map("source_type") // SALES_INVOICE, PURCHASE, CREDIT_NOTE, RETURN, DOCUMENT
  sourceId         String?   @map("source_id")
  resolvedById     String?   @map("resolved_by_id")
  resolvedByName   String?   @map("resolved_by_name")
  resolvedAt       DateTime? @map("resolved_at")
  resolutionReason String?   @map("resolution_reason")
  reviewNotes      Json?     @default("[]") @map("review_notes")
  history          Json?     @default("[]")
  documents        Json?     @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([category])
  @@index([customerType])
  @@index([status])
  @@index([createdAt])
  @@index([referenceNumber])
  @@map("ca_exceptions")
}


