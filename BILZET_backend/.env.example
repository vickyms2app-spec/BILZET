NODE_ENV=development
PORT=5000

# PostgreSQL — use a local or NeonDB serverless connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/bilzet_db?schema=public"

MONGODB_URI=mongodb://127.0.0.1:27017/shop_billing

JWT_SECRET=replace_with_secure_secret_key_at_least_32_characters_long_12345
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_refresh_secret_key_at_least_32_chars_12345
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5173

# Clerk — get these from https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY_HERE

SHOP_NAME=Bilzet Retail Mart
SHOP_PHONE=+91 9876543210
SHOP_EMAIL=contact@bilzet.com
SHOP_ADDRESS=123 Commercial Plaza, Main Market
SHOP_GSTIN=29ABCDE1234F1Z5
SHOP_STATE=Karnataka
SHOP_STATE_CODE=29
