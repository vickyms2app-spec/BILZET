# ==========================================
# BILZET BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env for local development
# NEVER commit .env to version control
# ==========================================

# Application
NODE_ENV=development
PORT=5000

# Database (PostgreSQL - Local or NeonDB serverless connection string)
DATABASE_URL=
MONGODB_URI=

# Clerk Authentication (Get from https://dashboard.clerk.com -> API Keys)
# Development: pk_test_... and sk_test_...
# Production:  pk_live_... and sk_live_...
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend Configuration & CORS
FRONTEND_URL=http://localhost:5173

# JWT Authentication (At least 32 characters long)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Admin & Shop Defaults
ADMIN_EMAILS=
SHOP_NAME=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_ADDRESS=
SHOP_GSTIN=
SHOP_STATE=
SHOP_STATE_CODE=

# Email Service (SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
ALLOW_MOCK_EMAIL=true

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PREMIUM_PLAN_ID=

# SMS Service Providers (Optional)
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
